import re
import random
from collections import Counter
from itertools import tee, islice
import pandas as pd
import pandas
import nltk

nltk.download('names', quiet=True)  # one-time download, skipped if already present
from nltk.corpus import names
nameList = {n.lower() for n in names.words()}
allSentences=[]



def ngrams(lst, n):
  tlst = lst
  while True:
    a, b = tee(tlst)
    l = tuple(islice(a, n))
    if len(l) == n:
      yield l
      next(b)
      tlst = b
    else:
      break

bijectTotal=Counter()
trijectTotal=Counter()

for i in range(151):
  index=i+1
  fileName="ajsalis_page_"+str(index)+".csv"
  allMsg=pandas.read_csv(fileName,usecols=["content"])
  allMsg.fillna(" ", inplace=True)
  allMsg_s=allMsg.astype(str)
  all_values = allMsg_s.stack().tolist()
  single_line = " ".join(all_values)
  words = re.findall(r"\w+", single_line) #, re.IGNORECASE
  words = ["undefined" if w[:1].isupper() and w.strip('.,!?;:"\'').lower() in nameList else w for w in words]
  c=Counter(ngrams(words, 2)) #list of tuples
  c2=Counter(ngrams(words,3))
  bijectTotal.update(c)
  trijectTotal.update(c2)
  allSentences+=all_values

# print(bijectTotal.most_common(500))
#total is a counter of tuples, including lowercase

#filter total to only include uppercase bijections

uppercaseBijectTotals=Counter()
uppercaseTrijectTotals=Counter()

allBijects=list(bijectTotal.elements())
allTrijects=list(trijectTotal.elements())

for biject in allBijects:
  firstWord, secondWord=biject
  if firstWord[0].isupper():
    uppercaseBijectTotals.update([biject])

for triject in allTrijects:
  firstWord, secondWord,thirdWord =triject
  if firstWord[0].isupper():
    uppercaseTrijectTotals.update([triject])

